/*--------------------------------*- C++ -*----------------------------------*\
| controlDict for Re=200 inverse-Arnoldi solve                                 |
\*---------------------------------------------------------------------------*/

FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     StabilitySolver;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         0;
deltaT          0;
writeControl    timeStep;
writeInterval   1;
purgeWrite      0;
writeFormat     binary;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   10;
runTimeModifiable true;
