/*--------------------------------*- C++ -*----------------------------------*\
| Initial velocity field                                                      |
\*---------------------------------------------------------------------------*/

FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    movingLid
    {
        type            fixedValue;
        // lid moves along the horizontal diagonal, |U| = 1
        value           uniform (0.70710678118654752 0.70710678118654752 0);
    }

    fixedWalls
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
}

