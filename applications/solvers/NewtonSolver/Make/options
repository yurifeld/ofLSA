# MPI flags come from OpenFOAM's rules for the MPI it was built with
# (WM_MPLIB: OpenMPI, Intel MPI, MPICH, ...), so any of them works.
-include $(GENERAL_RULES)/mplibType

EXE_INC = \
    $(PFLAGS) $(PINC) \
    -I$(OFLSA_DIR)/src/matrixFreeFGMRESSafe/lnInclude \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude

EXE_LIBS = \
    $(PLIBS) \
    -lfiniteVolume \
    -lmeshTools

